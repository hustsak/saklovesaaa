rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public visitors can view the photographs
    // Only authenticated users (Viraksak & Chanreaksa) can upload, replace, or delete photos
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
