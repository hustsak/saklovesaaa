rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public visitors can view the diary, memories, and photos
    // Only authenticated users (Viraksak & Chanreaksa) can add, modify, or delete data
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
